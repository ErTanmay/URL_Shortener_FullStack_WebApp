<div class="container" style="padding: 2rem 1rem; min-height: 100vh;">
  <div style="max-width: 450px; margin: 0 auto;">
    <div class="card">
      @if (step() === 'email') {
        <div class="text-center mb-4">
          <div style="width: 80px; height: 80px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
            <span style="font-size: 2.5rem;">🔐</span>
          </div>
          <h1 style="margin-bottom: 0.5rem; font-size: 2rem; font-weight: 700;">Forgot Password?</h1>
          <p style="color: var(--text-secondary);">
            Enter your email address and we'll send you a verification code
          </p>
        </div>

        @if (errorMessage()) {
          <div class="alert alert-error">
            <span>⚠️</span>
            <span>{{ errorMessage() }}</span>
          </div>
        }

        <form [formGroup]="emailForm" (ngSubmit)="sendCode()">
          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input 
              type="email" 
              class="form-control"
              [class.error]="emailForm.controls['email'].invalid && emailForm.controls['email'].touched"
              formControlName="email"
              placeholder="your.email@example.com">
            @if (emailForm.controls['email'].invalid && emailForm.controls['email'].touched) {
              <div class="form-error">
                @if (emailForm.controls['email'].errors?.['required']) {
                  <span>Email is required</span>
                }
                @if (emailForm.controls['email'].errors?.['email']) {
                  <span>Please enter a valid email</span>
                }
              </div>
            }
          </div>

          <button 
            type="submit" 
            class="btn btn-primary btn-block"
            [disabled]="loading()">
            @if (loading()) {
              <span class="spinner"></span>
            }
            <span>{{ loading() ? 'Sending...' : 'Send Verification Code' }}</span>
          </button>
        </form>

        <div class="text-center mt-3">
          <a routerLink="/login" style="color: var(--text-secondary);">← Back to login</a>
        </div>
      }

      @if (step() === 'verify') {
        <div class="text-center mb-4">
          <div style="width: 80px; height: 80px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
            <span style="font-size: 2.5rem;">🔑</span>
          </div>
          <h1 style="margin-bottom: 0.5rem; font-size: 2rem; font-weight: 700;">Reset Password</h1>
          <p style="color: var(--text-secondary);">
            We've sent a code to<br>
            <strong>{{ email() }}</strong>
          </p>
        </div>

        @if (errorMessage()) {
          <div class="alert alert-error">
            <span>⚠️</span>
            <span>{{ errorMessage() }}</span>
          </div>
        }

        @if (successMessage()) {
          <div class="alert alert-success">
            <span>✓</span>
            <span>{{ successMessage() }}</span>
          </div>
        }

        <form [formGroup]="resetForm" (ngSubmit)="resetPassword()">
          <div class="form-group">
            <label class="form-label">Verification Code</label>
            <input 
              type="text" 
              class="form-control"
              style="text-align: center; font-size: 1.5rem; letter-spacing: 0.5rem; font-weight: 600;"
              [class.error]="resetForm.controls['verificationCode'].invalid && resetForm.controls['verificationCode'].touched"
              formControlName="verificationCode"
              placeholder="000000"
              maxlength="6">
            @if (resetForm.controls['verificationCode'].invalid && resetForm.controls['verificationCode'].touched) {
              <div class="form-error">
                @if (resetForm.controls['verificationCode'].errors?.['required']) {
                  <span>Verification code is required</span>
                }
                @if (resetForm.controls['verificationCode'].errors?.['pattern']) {
                  <span>Please enter a valid 6-digit code</span>
                }
              </div>
            }
          </div>

          <div class="form-group">
            <label class="form-label">New Password</label>
            <input 
              type="password" 
              class="form-control"
              [class.error]="resetForm.controls['password'].invalid && resetForm.controls['password'].touched"
              formControlName="password"
              placeholder="Enter new password">
            @if (resetForm.controls['password'].invalid && resetForm.controls['password'].touched) {
              <div class="form-error">
                @if (resetForm.controls['password'].errors?.['required']) {
                  <span>Password is required</span>
                }
                @if (resetForm.controls['password'].errors?.['minlength']) {
                  <span>Minimum 8 characters required</span>
                }
                @if (resetForm.controls['password'].errors?.['pattern']) {
                  <span>Password must contain uppercase, lowercase, number and special character</span>
                }
              </div>
            }
          </div>

          <button 
            type="submit" 
            class="btn btn-primary btn-block"
            [disabled]="loading()">
            @if (loading()) {
              <span class="spinner"></span>
            }
            <span>{{ loading() ? 'Resetting...' : 'Reset Password' }}</span>
          </button>
        </form>

        <div class="text-center mt-3">
          <a routerLink="/login" style="color: var(--text-secondary);">← Back to login</a>
        </div>
      }
    </div>
  </div>
</div>
